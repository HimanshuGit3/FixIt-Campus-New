{
  // D8: the API address is passed at build time. Change the LAN IP to your laptop's
  // IPv4 address (run `ipconfig`) and allow TCP 5000 through Windows Firewall (README).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FixIt (emulator)",
      "type": "dart",
      "request": "launch",
      "cwd": "mobile",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:5000"]
    },
    {
      // Phone plugged in by USB: `adb reverse` tunnels the phone's port 5000 to this laptop,
      // so no Wi-Fi, LAN IP or firewall setup is needed.
      "name": "FixIt (phone via USB)",
      "type": "dart",
      "request": "launch",
      "cwd": "mobile",
      "program": "lib/main.dart",
      "preLaunchTask": "adb reverse 5000",
      "args": ["--dart-define=API_BASE_URL=http://127.0.0.1:5000"]
    },
    {
      "name": "FixIt (phone on same Wi-Fi)",
      "type": "dart",
      "request": "launch",
      "cwd": "mobile",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://172.17.110.188:5000"]
    }
  ]
}
